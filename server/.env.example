# Express Backend Service Environment Configuration Template

PORT=5001
NODE_ENV=production

# Database Connection String
# Docker Compose: postgresql://postgres:password@postgres:5432/campfund
# Local Standalone Node: postgresql://postgres:password@localhost:5432/campfund
DATABASE_URL=postgresql://postgres:password@postgres:5432/campfund

# Security Token Secret
JWT_SECRET=your_super_secret_jwt_key_here

# Allowed Origin for CORS
CLIENT_URL=http://localhost:5173
