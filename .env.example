# FundCamp Global Environment Configuration Template

# Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=fundcamp
POSTGRES_PORT=5432

# Express Server Settings
SERVER_PORT=5001
NODE_ENV=production
DATABASE_URL=postgresql://postgres:password@postgres:5432/fundcamp
JWT_SECRET=fundcamp_production_super_secret_jwt_key_2026

# Client & Network Settings
CLIENT_PORT=5173
CLIENT_URL=http://localhost:5173
VITE_API_URL=/api

# AI Assistant (OpenAI-compatible chat completions — Groq)
# NOTE: keep AI_ENABLED=false in this template. deploy.yml and ci.yml both run
# `cp .env.example .env`, so shipping this disabled keeps deploys and CI green
# until you deliberately opt in. AI_API_KEY is intentionally empty here — the
# real key belongs in the untracked root .env and must never be committed.
# Keep this pointed at a publicly reachable host, not a localhost proxy: inside a
# container, localhost is the container itself. Local dev overrides go in .env.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_API_KEY=
AI_ENABLED=false

# AI guardrails (optional — defaults shown)
# MAX_TOKENS must leave room for the model's reasoning trace: at 400 the helper
# truncated mid-reasoning and returned empty content. Actual use averages ~600.
AI_MAX_TOKENS=1500
AI_TIMEOUT_MS=20000
AI_ANON_HOURLY_LIMIT=10
AI_USER_HOURLY_LIMIT=60
AI_ANON_DAILY_LIMIT=300
